# History control
shopt -s histappend
HISTCONTROL=ignoreboth
HISTSIZE=32768
HISTFILESIZE="${HISTSIZE}"

# Autocompletion
source "/usr/share/bash-completion/bash_completion"

# Set complete path
export PATH="$HOME/.local/bin:$HOME/.local/share/justbuntu/bin:$PATH"

export JUSTBUNTU_PATH="$HOME/.local/share/justbuntu"
