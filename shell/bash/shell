# History control
shopt -s histappend
HISTCONTROL=ignoreboth
HISTSIZE=32768
HISTFILESIZE="${HISTSIZE}"
# Autocompletion
source "/usr/share/bash-completion/bash_completion"
# Homebrew — if installed, add to PATH and environment
if [ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"
elif [ -x "$HOME/.linuxbrew/bin/brew" ]; then
  eval "$($HOME/.linuxbrew/bin/brew shellenv bash)"
fi
# Set complete path
export PATH="$HOME/.local/bin:$HOME/.local/share/justbuntu/bin:$PATH"
export JUSTBUNTU_PATH="$HOME/.local/share/justbuntu"
