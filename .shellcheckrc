# SC1090: Can't follow non-constant source. Our architecture intentionally uses
# dynamic sourcing from variables (e.g., source "$INSTALLER_FILE"). Unfixable.
disable=SC1090

# SC1091: Not following external sourced file. ShellCheck cannot follow files
# that are installed at runtime (e.g., Homebrew shellenv, helper scripts).
# Architectural, not a bug.
disable=SC1091
