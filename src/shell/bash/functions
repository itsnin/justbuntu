# detect available chromium-based browser
_find_browser() {
  if command -v google-chrome-stable >/dev/null 2>&1; then
    echo "google-chrome-stable"
  elif command -v brave >/dev/null 2>&1; then
    echo "brave"
  elif command -v brave-browser >/dev/null 2>&1; then
    echo "brave-browser"
  elif command -v brave-origin >/dev/null 2>&1; then
    echo "brave-origin"
  elif command -v chromium >/dev/null 2>&1; then
    echo "chromium"
  else
    echo ""
  fi
}

# Functions for web app management
web2app() {
  if [ "$#" -ne 3 ]; then
    echo "Usage: web2app <AppName> <AppURL> <IconURL>"
    return 1
  fi
  local APP_NAME="$1"
  local APP_URL="$2"
  local ICON_URL="$3"
  local BROWSER="$(_find_browser)"
  if [ -z "$BROWSER" ]; then
    echo "Error: No Chromium-based browser found. Install Chrome or Brave first."
    return 1
  fi
  local ICON_DIR="$HOME/.local/share/applications/icons"
  local DESKTOP_FILE="$HOME/.local/share/applications/${APP_NAME}.desktop"
  local ICON_PATH="${ICON_DIR}/${APP_NAME}.png"
  mkdir -p "$ICON_DIR"
  if ! curl -sL -o "$ICON_PATH" "$ICON_URL"; then
    echo "Error: Failed to download icon."
    return 1
  fi
  cat > "$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Name=$APP_NAME
Comment=$APP_NAME
Exec=$BROWSER --app="$APP_URL" --name="$APP_NAME" --class="$APP_NAME" --window-size=800,600
Terminal=false
Type=Application
Icon=$ICON_PATH
Categories=GTK;
MimeType=text/html;text/xml;application/xhtml_xml;
StartupNotify=true
EOF
  chmod +x "$DESKTOP_FILE"
}

web2app-remove() {
  if [ "$#" -ne 1 ]; then
    echo "Usage: web2app-remove <AppName>"
    return 1
  fi
  local APP_NAME="$1"
  local ICON_DIR="$HOME/.local/share/applications/icons"
  local DESKTOP_FILE="$HOME/.local/share/applications/${APP_NAME}.desktop"
  local ICON_PATH="${ICON_DIR}/${APP_NAME}.png"
  rm -f "$DESKTOP_FILE"
  rm -f "$ICON_PATH"
}

app2folder() {
  if [ "$#" -ne 2 ]; then
    echo "Usage: app2folder <desktop_file.desktop> <folder_name>"
    return 1
  fi
  local DESKTOP_FILE="$1"
  local FOLDER="$2"
  local SCHEMA="org.gnome.desktop.app-folders.folder:/org/gnome/desktop/app-folders/folders/$FOLDER/"
  # Use Python to safely parse and modify the gsettings array. Avoids fragile
  # string parsing that can break if the array format changes.
  python3 - "$SCHEMA" "$DESKTOP_FILE" << 'PYINNER'
import sys, subprocess
schema, desktop_file = sys.argv[1], sys.argv[2]
result = subprocess.run(["gsettings", "get", schema, "apps"], capture_output=True, text=True)
current = result.stdout.strip()
# Use ast.literal_eval to safely parse the gsettings array format
import ast
try:
    apps = ast.literal_eval(current)
except (ValueError, SyntaxError):
    apps = []
if desktop_file not in apps:
    apps.append(desktop_file)
    new_value = str(apps).replace('", "', "', '").replace('["', "['").replace('"]', "']")
    subprocess.run(["gsettings", "set", schema, "apps", new_value])
PYINNER
}

app2folder-remove() {
  if [ "$#" -ne 2 ]; then
    echo "Usage: app2folder-remove <desktop_file.desktop> <folder_name>"
    return 1
  fi
  local DESKTOP_FILE="$1"
  local FOLDER="$2"
  local SCHEMA="org.gnome.desktop.app-folders.folder:/org/gnome/desktop/app-folders/folders/$FOLDER/"
  python3 - "$SCHEMA" "$DESKTOP_FILE" << 'PYINNER'
import sys, subprocess
schema, desktop_file = sys.argv[1], sys.argv[2]
result = subprocess.run(["gsettings", "get", schema, "apps"], capture_output=True, text=True)
current = result.stdout.strip()
import ast
try:
    apps = ast.literal_eval(current)
except (ValueError, SyntaxError):
    apps = []
if desktop_file in apps:
    apps = [a for a in apps if a != desktop_file]
    new_value = str(apps).replace('", "', "', '").replace('["', "['").replace('"]', "']")
    subprocess.run(["gsettings", "set", schema, "apps", new_value])
PYINNER
}
