# Auto-detect text files and normalize line endings to LF in the repository
* text=auto eol=lf

# Shell scripts — must be LF, CRLF breaks shebang lines
*.sh text eol=lf
*.bash text eol=lf

# Documentation and config
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf

# Binary files — never modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
